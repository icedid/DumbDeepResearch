# DumbDeepResearch (DDR) Runtime Configuration
DDR_BIND_ADDR=127.0.0.1:3001
DDR_DATA_DIR=data
DDR_MIN_QUALITY_WORDS=250

# Search Providers (optional: falls back automatically to DuckDuckGo HTML + Wikipedia API)
DDR_SEARCH_ENDPOINT=http://127.0.0.1:8080
# BRAVE_API_KEY=

# Local Micro-SLM Extraction (optional: defaults to 0% hallucination algorithmic extraction)
DDR_USE_OLLAMA=0
DDR_OLLAMA_URL=http://127.0.0.1:11434
# DDR_OLLAMA_MODEL=qwen3:14b
